/* pages/index/index.wxss */

page {
  --color-primary:       #3CAB6E;
  --color-primary-light: #EBF6F0;
  --color-primary-deep:  #2e8f5a;
  --color-bg:            #F7F8FA;
  --color-card:          #FFFFFF;
  --color-text-main:     #1A1A1A;
  --color-text-sub:      #8A8A8A;
  --color-divider:       #EEEEEE;
  --shadow-card:         0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  background-color: var(--color-bg);
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

.page-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg);
}

/* ---- AI Banner ---- */
.generate-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 24rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #3CAB6E, #2e8f5a);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(60, 171, 110, 0.30);
}

.generate-banner--hover { opacity: 0.85; }

.banner-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.banner-icon { font-size: 44rpx; }

.banner-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.banner-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.banner-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
}

/* ---- 分类筛选 ---- */
.category-scroll {
  width: 100%;
  flex-shrink: 0;
}

.category-row {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx 20rpx;
  gap: 12rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 28rpx;
  background-color: var(--color-card);
  border-radius: 100rpx;
  border: 2rpx solid var(--color-divider);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.category-chip--active {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.category-chip--hover { opacity: 0.75; }

.category-chip__label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-sub);
}

.category-chip--active .category-chip__label {
  color: #FFFFFF;
  font-weight: 600;
}

/* ---- 篇数统计条 ---- */
.count-bar {
  padding: 0 32rpx 16rpx;
}

.count-bar__text {
  font-size: 22rpx;
  color: var(--color-text-sub);
}

/* ---- 文章列表 ---- */
.scroll-area {
  flex: 1;
  overflow: hidden;
  padding: 0 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 32rpx;
}

.article-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: var(--color-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  gap: 20rpx;
}

.article-card--hover { background-color: #f5f5f5; }

.card-left {
  width: 56rpx;
  height: 56rpx;
  border-radius: 100rpx;
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-index {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-tags {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.tag {
  background-color: var(--color-primary-light);
  border-radius: 100rpx;
  padding: 4rpx 16rpx;
}

.tag--category {
  background-color: #EEF2FF;
}

.tag--category .tag-text {
  color: #5B6EE8;
}

.tag-text {
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
  line-height: 1.4;
}

.card-desc {
  font-size: 24rpx;
  color: var(--color-text-sub);
  line-height: 1.5;
}

.card-arrow {
  font-size: 40rpx;
  color: var(--color-text-sub);
  font-weight: 300;
  flex-shrink: 0;
}

/* ---- 空状态 ---- */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

.empty-emoji { font-size: 80rpx; }

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--color-text-sub);
  text-align: center;
  line-height: 1.8;
}

.empty-btn {
  margin-top: 8rpx;
  background-color: var(--color-primary);
  border-radius: 100rpx;
  padding: 20rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(60,171,110,0.30);
}

.empty-btn--hover { opacity: 0.85; }

.empty-btn__text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}
