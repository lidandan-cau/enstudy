/* pages/review/review.wxss */

page {
  --color-primary:       #3CAB6E;
  --color-primary-light: #EBF6F0;
  --color-primary-deep:  #2e8f5a;
  --color-bg:            #F7F8FA;
  --color-card:          #FFFFFF;
  --color-text-main:     #1A1A1A;
  --color-text-sub:      #8A8A8A;
  --color-divider:       #EEEEEE;
  background-color: var(--color-bg);
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

.page-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg);
}

/* ======================================================
   筛选标签栏
   ====================================================== */
.filter-bar {
  display: flex;
  flex-direction: row;
  background-color: var(--color-card);
  border-bottom: 1rpx solid var(--color-divider);
  flex-shrink: 0;
}

.filter-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 16rpx;
  gap: 4rpx;
  border-bottom: 4rpx solid transparent;
}

.filter-tab--active {
  border-bottom-color: var(--color-primary);
}

.filter-tab--hover { opacity: 0.7; }

.filter-tab__label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-sub);
}

.filter-tab--active .filter-tab__label {
  font-weight: 700;
  color: var(--color-primary);
}

.filter-tab__count {
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.filter-tab--active .filter-tab__count {
  color: var(--color-primary);
}

/* ======================================================
   进度头部
   ====================================================== */
.progress-header {
  padding: 32rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-info {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-main);
  letter-spacing: 1rpx;
}

.progress-count {
  font-size: 26rpx;
  color: var(--color-text-sub);
  font-weight: 500;
}

.progress-bar-wrap {
  height: 8rpx;
  background-color: var(--color-divider);
  border-radius: 100rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--color-primary);
  border-radius: 100rpx;
  transition: width 0.3s ease;
}

/* ======================================================
   词卡
   ====================================================== */
.card-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.word-card {
  width: 100%;
  background-color: var(--color-card);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  min-height: 360rpx;
  justify-content: center;
}

.word-card--hover { opacity: 0.92; }

.word-card--revealed {
  box-shadow: 0 8rpx 40rpx rgba(60, 171, 110, 0.15);
  border: 2rpx solid var(--color-primary-light);
}

/* 英文单词 */
.word-en-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.word-en {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--color-text-main);
  letter-spacing: 2rpx;
  text-align: center;
}

.word-phonetic {
  font-size: 32rpx;
  color: var(--color-text-sub);
  letter-spacing: 1rpx;
}

/* 分割线 */
.word-divider {
  width: 80rpx;
  height: 2rpx;
  background-color: var(--color-divider);
  border-radius: 100rpx;
}

/* 中文释义 */
.word-zh {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 4rpx;
  text-align: center;
}

/* 点击提示 */
.reveal-hint {
  margin-top: 8rpx;
  background-color: var(--color-primary-light);
  border-radius: 100rpx;
  padding: 12rpx 32rpx;
}

.reveal-hint__text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ======================================================
   底部操作栏
   ====================================================== */
.action-bar {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 24rpx 32rpx 48rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 120rpx;
  border-radius: 24rpx;
}

.action-btn--unknown {
  background-color: #FFF5F5;
  border: 2rpx solid #FFDDDD;
}

.action-btn--known {
  background-color: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}

.action-btn--disabled {
  opacity: 0.4;
}

.action-btn--hover { opacity: 0.75; }

.action-btn__icon {
  font-size: 40rpx;
}

.action-btn__text {
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn--unknown .action-btn__text { color: #E05A5A; }
.action-btn--known   .action-btn__text { color: var(--color-primary); }

/* ======================================================
   完成结果页
   ====================================================== */
.result-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 0 40rpx 100rpx;
}

.result-emoji { font-size: 96rpx; }

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-main);
  letter-spacing: 2rpx;
}

.result-stats {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin: 8rpx 0;
}

.result-stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 32rpx 0;
  border-radius: 20rpx;
}

.result-stat-card--green {
  background-color: var(--color-primary-light);
}

.result-stat-card--orange {
  background-color: #FFF5EC;
}

.result-stat-num {
  font-size: 56rpx;
  font-weight: 700;
}

.result-stat-card--green .result-stat-num { color: var(--color-primary); }
.result-stat-card--orange .result-stat-num { color: #E07C2E; }

.result-stat-label {
  font-size: 24rpx;
  color: var(--color-text-sub);
  font-weight: 500;
}

.restart-btn {
  margin-top: 8rpx;
  background-color: var(--color-primary);
  border-radius: 100rpx;
  padding: 24rpx 64rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 171, 110, 0.30);
}

.restart-btn--hover { opacity: 0.85; }

.restart-btn__text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ======================================================
   空状态
   ====================================================== */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 48rpx 120rpx;
}

.empty-emoji { font-size: 80rpx; }

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--color-text-sub);
  text-align: center;
  line-height: 1.8;
}

.go-read-btn {
  margin-top: 8rpx;
  background-color: var(--color-primary);
  border-radius: 100rpx;
  padding: 20rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 171, 110, 0.30);
}

.go-read-btn--hover { opacity: 0.85; }

.go-read-btn__text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
